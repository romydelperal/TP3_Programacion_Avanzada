class Punto:
  def __init__(self, eje_x, eje_y):
    self.eje_x = eje_x
    self.eje_y = eje_y
  
  def impresion(self):
    return f"Se encuentra en el punto (x;y): ({self.eje_x};{self.eje_y})"
  
  def opuesto(self):
    return Punto(-self.eje_x, -self.eje_y)

punto_1 = Punto(4,3)
print(punto_1.impresion())
punto2 = punto_1.opuesto()
print(punto2.impresion())
