        "class Punto:\n",
        "  def __init__(self, eje_x, eje_y):\n",
        "    self.eje_x = eje_x\n",
        "    self.eje_y = eje_y\n",
        "\n",
        "  def impresion(self):\n",
        "    return f\"Se encuentra en el punto (x;y): ({self.eje_x};{self.eje_y})\"\n",
        "\n",
        "  def opuesto(self):\n",
        "    return Punto(-self.eje_x, -self.eje_y)\n",
        "\n",
        "punto_1 = Punto(4,3)\n",
        "print(punto_1.impresion())\n",
        "punto2 = punto_1.opuesto()\n",
        "print(punto2.impresion())\n",
        "\n",
